<Window x:Class="DelayStart.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:DelayStart.Localization"
        Title="{Binding WindowTitle}"
        Width="920" Height="800" MinWidth="700" MinHeight="640"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,8" />
        </Style>

        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
                <TextBlock Text="{l:Tr Language}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox MinWidth="150" SelectedValuePath="Tag" SelectedValue="{Binding Language}">
                    <ComboBoxItem Tag="auto" Content="{l:Tr LanguageAuto}" />
                    <ComboBoxItem Tag="bg" Content="Български" />
                    <ComboBoxItem Tag="en" Content="English" />
                </ComboBox>
            </StackPanel>
            <CheckBox IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center">
                <TextBlock Text="{l:Tr StartWithWindows}" TextWrapping="Wrap" />
            </CheckBox>
        </DockPanel>

        <Border Grid.Row="1" Margin="0,12,0,0" Padding="12,10" CornerRadius="6"
                Background="#FFF4CE" BorderBrush="#E5C365" BorderThickness="1"
                Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="#5C4500" />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,8">
            <Button Content="{l:Tr AddProgram}" Click="Add_Click" />
            <Button Content="{l:Tr Remove}" Margin="8,0,0,0" Click="Remove_Click"
                    IsEnabled="{Binding HasSelection}" />
            <Button Content="{l:Tr TestNow}" Margin="8,0,0,0" Click="Test_Click"
                    IsEnabled="{Binding HasSelection}"
                    ToolTip="{l:Tr TestNowTooltip}" />
        </StackPanel>

        <DataGrid Grid.Row="3" x:Name="ProgramsGrid"
                  ItemsSource="{Binding Programs}"
                  SelectedItem="{Binding SelectedProgram}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="{l:Tr ColumnEnabled}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                      MinWidth="0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{l:Tr ColumnName}" Binding="{Binding DisplayName}" Width="2*"
                                    ElementStyle="{StaticResource CellText}" />
                <DataGridTextColumn Header="{l:Tr ColumnDelay}" Binding="{Binding DelaySeconds}"
                                    ElementStyle="{StaticResource CellText}" />
                <DataGridTemplateColumn Header="{l:Tr ColumnAdmin}">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding RunAsAdmin, UpdateSourceTrigger=PropertyChanged}"
                                      MinWidth="0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{l:Tr ColumnPath}" Binding="{Binding Path}" Width="3*"
                                    ElementStyle="{StaticResource CellText}" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Margin="0,16,0,0" IsEnabled="{Binding HasSelection}">
            <TextBlock Text="{l:Tr SelectedProgram}" FontWeight="SemiBold" Margin="0,0,0,10" />
            <Grid DataContext="{Binding SelectedProgram}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{l:Tr FieldName}" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{l:Tr FieldNameTooltip}" />

                <TextBlock Grid.Row="1" Text="{l:Tr FieldProgram}" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                         Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Row="1" Grid.Column="2" Content="{l:Tr Browse}" Margin="8,0,0,8" Click="BrowsePath_Click" />

                <TextBlock Grid.Row="2" Text="{l:Tr FieldArguments}" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,8"
                         Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Row="3" Text="{l:Tr FieldWorkingDirectory}" Style="{StaticResource FieldLabel}" />
                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8"
                         Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{l:Tr FieldWorkingDirectoryTooltip}" />
                <Button Grid.Row="3" Grid.Column="2" Content="{l:Tr Browse}" Margin="8,0,0,8" Click="BrowseFolder_Click" />

                <TextBlock Grid.Row="4" Text="{l:Tr FieldDelay}" Style="{StaticResource FieldLabel}" Margin="0,0,12,0" />
                <StackPanel Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                    <TextBox Width="90" HorizontalContentAlignment="Right"
                             Text="{Binding DelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{l:Tr SecondsAfterSignIn}" VerticalAlignment="Center" Margin="8,0,32,0" />
                    <CheckBox Content="{l:Tr RunAsAdmin}" IsChecked="{Binding RunAsAdmin}" Margin="0,0,24,0" />
                    <CheckBox Content="{l:Tr Enabled}" IsChecked="{Binding Enabled}" />
                </StackPanel>
            </Grid>
        </StackPanel>

        <Expander Grid.Row="5" Header="{l:Tr LastRun}" Margin="0,12,0,0">
            <TextBox Text="{Binding LastRun, Mode=OneWay}" IsReadOnly="True" Height="130" Margin="0,8,0,0"
                     FontFamily="Cascadia Mono, Consolas"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </Expander>

        <DockPanel Grid.Row="6" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right" Content="{l:Tr Close}" MinWidth="100" Margin="8,0,0,0" Click="Close_Click" />
            <Button DockPanel.Dock="Right" Content="{l:Tr Save}" MinWidth="100" Click="Save_Click"
                    Style="{DynamicResource AccentButtonStyle}" />
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.75" />
        </DockPanel>
    </Grid>
</Window>
